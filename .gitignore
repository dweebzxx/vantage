# NOTE: a trailing-slash gitignore pattern (e.g. /scripts/) only matches a real
# directory, not a symlink — even a symlink pointing at a directory. Since
# scripts/, .agents/, .codex/, .claude/, and audit/ at the project root are
# symlinks (or contain symlinks) into .vantage-private/, repeat them here without the
# trailing slash so they are actually excluded.
/scripts
/.agents
/.codex
/.claude
/audit

# Tool-managed local state (not versioned)
/.antigravitycli/

# Build-report split (reports/metadata-reports symlinked to .vantage-private/; rest local-only)
build-report-logs/launchers/
build-report-logs/logs/
build-report-logs/prompts/
build-report-logs/reports/
build-report-logs/metadata-reports/

